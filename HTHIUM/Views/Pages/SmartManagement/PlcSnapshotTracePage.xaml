<Page
    x:Class="HTHIUM.Views.Pages.SmartManagement.PlcSnapshotTracePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="1600"
    Background="#0B1220"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="DarkPanel" TargetType="Border">
            <Setter Property="Background" Value="#0F1829" />
            <Setter Property="BorderBrush" Value="#263449" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="InnerPanel" TargetType="Border">
            <Setter Property="Background" Value="#101A2C" />
            <Setter Property="BorderBrush" Value="#263449" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7F92AB" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="FlatAlarmButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="20,9" Background="#111B2D" BorderBrush="#24344D" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="286" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock
                        FontSize="23"
                        LineHeight="29"
                        Style="{StaticResource TitleText}"
                        Text="报警触发时 PLC 状态快照追溯"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="13"
                        LineHeight="18"
                        Foreground="#89A0BC"
                        Text="事件取证台：冻结 PLC / HMI / MES / 网络状态，回放故障前后状态变化"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="90" Height="32" Margin="0,0,8,0" Background="#1E63FF" BorderBrush="#1E63FF" Command="{Binding RefreshCommand}" Content="快照回放" Foreground="White" />
                    <Button Width="90" Height="32" Margin="0,0,8,0" Background="#16243A" BorderBrush="#334761" Content="导出证据" Foreground="#BCD0E8" />
                    <Button Width="82" Height="32" Background="#16243A" BorderBrush="#334761" Content="生成工单" Foreground="#BCD0E8" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="462" />
            </Grid.ColumnDefinitions>

            <Border Padding="18,18" Style="{StaticResource DarkPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="19" Style="{StaticResource TitleText}" Text="报警事件索引" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" Text="点击报警后刷新右侧快照数据" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AlarmItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding DataContext.SelectAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource FlatAlarmButton}">
                                        <Border Height="86" Padding="14,10" Background="{Binding Background}" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="13" Height="13" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,7,0,0" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="14" Foreground="#F7FAFF" Text="{Binding Time}" />
                                                        <Border Margin="8,0,0,0" Padding="7,1" Background="{Binding Color}" CornerRadius="8">
                                                            <TextBlock FontSize="11" Foreground="White" Text="{Binding Level}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="#D9E4F2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="#7F92AB" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="116" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="18,10" Style="{StaticResource InnerPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="1.18*" />
                            <ColumnDefinition Width="1.18*" />
                            <ColumnDefinition Width="0.72*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="产线" />
                            <TextBlock Margin="0,7,0,0" FontSize="15" Foreground="#F7FAFF" Text="{Binding SelectedLine}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="设备" />
                            <TextBlock Margin="0,7,0,0" FontSize="15" Foreground="#F7FAFF" Text="{Binding SelectedDevice}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="报警名称" />
                            <TextBlock Margin="0,7,0,0" FontSize="15" Foreground="#F05252" Text="{Binding AlarmName}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="触发时间" />
                            <TextBlock Margin="0,7,0,0" FontSize="15" Foreground="#F7FAFF" Text="{Binding TriggerTime}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource MutedText}" Text="窗口" />
                            <TextBlock Margin="0,7,0,0" FontSize="15" Foreground="#F7FAFF" Text="{Binding SnapshotWindow}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="18,12" Style="{StaticResource InnerPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock FontSize="17" Style="{StaticResource TitleText}" Text="快照回放时间轴" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Width="44" Height="26" Margin="0,0,8,0" Background="#16243A" BorderBrush="#334761" Content="-1s" Foreground="#BCD0E8" />
                                <Button Width="48" Height="26" Background="#1E63FF" BorderBrush="#1E63FF" Content="播放" Foreground="White" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding ReplayPoints}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22" />
                                            <RowDefinition Height="18" />
                                            <RowDefinition Height="18" />
                                            <RowDefinition Height="18" />
                                        </Grid.RowDefinitions>
                                        <Ellipse Width="14" Height="14" Fill="{Binding Color}" />
                                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="11" Foreground="{Binding Color}" Text="{Binding Offset}" />
                                        <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="11" Foreground="#D9E4F2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="3" HorizontalAlignment="Center" FontSize="10" Foreground="#7F92AB" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Padding="18,12" Style="{StaticResource InnerPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="84" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="17" Style="{StaticResource TitleText}" Text="设备状态链路" />
                            <ItemsControl Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding ProcessNodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="42" Margin="0,0,10,0" Background="#111B2D" BorderBrush="{Binding Color}" BorderThickness="2" CornerRadius="8">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="#D9E4F2" Text="{Binding Name}" />
                                                <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{Binding Color}" Text="{Binding State}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock FontSize="17" Style="{StaticResource TitleText}" Text="PLC 点位冻结对比" />
                                <TextBlock HorizontalAlignment="Right" FontSize="13" Foreground="#F05252" Text="异常 9 / 总点位 128" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.65*" />
                                    <ColumnDefinition Width="0.82*" />
                                    <ColumnDefinition Width="0.88*" />
                                    <ColumnDefinition Width="0.82*" />
                                    <ColumnDefinition Width="0.86*" />
                                    <ColumnDefinition Width="1.12*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" Foreground="#7F92AB" Text="中文点位" />
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="#7F92AB" Text="-10s" />
                                <TextBlock Grid.Column="2" FontSize="12" Foreground="#7F92AB" Text="触发时" />
                                <TextBlock Grid.Column="3" FontSize="12" Foreground="#7F92AB" Text="+10s" />
                                <TextBlock Grid.Column="4" FontSize="12" Foreground="#7F92AB" Text="变化" />
                                <TextBlock Grid.Column="5" FontSize="12" Foreground="#7F92AB" Text="证据" />
                            </Grid>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding SnapshotPoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="38">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.65*" />
                                                <ColumnDefinition Width="0.82*" />
                                                <ColumnDefinition Width="0.88*" />
                                                <ColumnDefinition Width="0.82*" />
                                                <ColumnDefinition Width="0.86*" />
                                                <ColumnDefinition Width="1.12*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#D9E4F2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#9CAFC7" Text="{Binding BeforeValue}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2" Height="24" Margin="0,7,10,7" Background="{Binding TriggerBackground}" BorderBrush="{Binding Color}" BorderThickness="1" CornerRadius="5">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Color}" Text="{Binding TriggerValue}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="#9CAFC7" Text="{Binding AfterValue}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Color}" Text="{Binding ChangeType}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="12" Foreground="#D9E4F2" Text="{Binding Evidence}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="4" Padding="20,16" Style="{StaticResource DarkPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="158" />
                        <RowDefinition Height="132" />
                        <RowDefinition Height="146" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="19" Style="{StaticResource TitleText}" Text="证据包与根因判断" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" Text="快照、日志、操作记录组合成可复盘证据" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,14,0,0" Padding="16,12" Background="#231A16" BorderBrush="#8A4F20" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="#F5A524" Text="初步根因" />
                            <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#F7FAFF" LineHeight="18" Text="{Binding RootCause}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12" Style="{StaticResource InnerPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock FontSize="16" Style="{StaticResource TitleText}" Text="根因可信度" />
                                <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="#F7FAFF" Text="{Binding ConfidenceText}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,13,0,0">
                                <ProgressBar Height="16" Maximum="100" Value="{Binding ConfidenceValue, Mode=OneWay}" Background="#24344D" BorderBrush="#24344D" Foreground="#F05252" />
                            </Grid>
                            <ItemsControl Grid.Row="2" Margin="0,4,0,0" ItemsSource="{Binding Metrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="38" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="11" Height="11" Fill="{Binding Color}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#9CAFC7" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Color}" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="3" Margin="0,12,0,0" ItemsSource="{Binding EvidenceCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="58" Margin="0,0,10,10" Background="#101A2C" BorderBrush="#263449" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Border Width="5" HorizontalAlignment="Left" Background="{Binding Color}" CornerRadius="8,0,0,8" />
                                        <StackPanel Margin="16,8,8,0">
                                            <TextBlock FontSize="12" Foreground="#9CAFC7" Text="{Binding Name}" />
                                            <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="#F7FAFF" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="4" Padding="16,12" Style="{StaticResource InnerPanel}">
                        <StackPanel>
                            <TextBlock FontSize="16" Style="{StaticResource TitleText}" Text="建议闭环动作" />
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ActionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="18" Height="18" Background="#1E63FF" CornerRadius="9">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="White" Text="{Binding Index}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="#D9E4F2" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
