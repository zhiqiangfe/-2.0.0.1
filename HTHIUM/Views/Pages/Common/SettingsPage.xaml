<Page
    x:Class="HTHIUM.Views.Pages.Common.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:HTHIUM.Views.Pages.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontSize="14"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <TabControl>
            <TabItem Header="全局设置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <hc:PropertyGrid
                        x:Name="GlobalPropertyGrid"
                        Grid.Row="0"
                        Margin="5"
                        SelectedObject="{Binding GlobalSettingsExtraModelObject}"
                        ShowSortButton="True" />

                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <!--<Button
                            Margin="5"
                            Command="{Binding RefreshGlobalCommand}"
                            Content="刷新"
                            FontSize="14"
                            Style="{StaticResource ButtonPrimary}" />-->
                        <Button
                            Margin="5"
                            Command="{Binding SaveGlobalCommand}"
                            Content="保存"
                            FontSize="14"
                            Style="{StaticResource ButtonSuccess}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="项目设置">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="选择项目：" />
                        <ComboBox
                            Width="200"
                            Margin="5"
                            ItemsSource="{Binding VMNames}"
                            SelectedItem="{Binding SelectedVM}" />
                    </StackPanel>

                    <hc:PropertyGrid
                        x:Name="ProjectPropertyGrid"
                        Grid.Row="1"
                        Margin="5"
                        SelectedObject="{Binding ProjectSettingsExtraModelObject}"
                        ShowSortButton="True" />

                    <StackPanel
                        Grid.Row="2"
                        Margin="5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="5"
                            Command="{Binding SaveProjectCommand}"
                            Content="保存"
                            FontSize="14"
                            Style="{StaticResource ButtonSuccess}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Background="#80000000" Visibility="{Binding IsSettingsLoading, Converter={StaticResource BoolToVisibility}}">
            <hc:LoadingCircle
                Width="50"
                Height="50"
                DotCount="5"
                DotInterval="10"
                DotSpeed="4"
                IsRunning="{Binding IsSettingsLoading}" />
        </Grid>
    </Grid>
</Page>
