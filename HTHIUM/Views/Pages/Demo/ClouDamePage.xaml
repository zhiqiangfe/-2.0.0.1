<Page
    x:Class="HTHIUM.Views.Pages.Demo.ClouDamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ClouDamePage"
    d:DesignHeight="900"
    d:DesignWidth="1440"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#FFF4F6F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Margin="16,16,16,10"
                Padding="18"
                Background="#FF102A43"
                CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Clou 接口测试台" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="#FFBCCCDC"
                        Text="面向 Pack 产线看板接口的实时联调页，支持 Host 注入服务、结果摘要、数据明细和原始 JSON 联合查看。" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="12,8"
                    Background="#1FFFFFFF"
                    CornerRadius="999">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#FF7EE787"
                            Text="状态" />
                        <TextBlock
                            Margin="10,0,0,0"
                            Foreground="White"
                            Text="{Binding RequestStatus}" />
                    </StackPanel>
                </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>

                <Border
                    Margin="0,0,10,0"
                    Padding="16"
                    Background="White"
                    BorderBrush="#FFE1E6EB"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#FF1F2933"
                        Text="请求面板" />

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            MinHeight="42"
                            Padding="12,10"
                            VerticalContentAlignment="Center"
                            Background="#FFF8FAFC"
                            BorderBrush="#FFD9E2EC"
                            BorderThickness="1"
                            Text="{Binding RequestUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="18,10"
                            Background="#FF2F855A"
                            BorderThickness="0"
                            Command="{Binding QueryCommand}"
                            Content="发起请求"
                            Foreground="White" />

                        <Button
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            Padding="18,10"
                            Background="#FF2B6CB0"
                            BorderThickness="0"
                            Command="{Binding LoadSampleCommand}"
                            Content="示例地址"
                            Foreground="White" />

                        <Button
                            Grid.Column="3"
                            Margin="10,0,0,0"
                            Padding="18,10"
                            Background="#FF718096"
                            BorderThickness="0"
                            Command="{Binding ClearCommand}"
                            Content="清空结果"
                            Foreground="White" />
                    </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="White"
                    BorderBrush="#FFE1E6EB"
                    BorderThickness="1"
                    CornerRadius="12">
                    <ItemsControl ItemsSource="{Binding StatusItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,10,10"
                                    Padding="12"
                                    Background="#FFF8FAFC"
                                    BorderBrush="#FFD9E2EC"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="#FF52606D"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="#FF1F2933"
                                            Text="{Binding Value}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="16,0,16,16" MinHeight="620">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="420" />
                        <RowDefinition Height="220" />
                    </Grid.RowDefinitions>

                    <Border
                        Margin="0,0,10,10"
                        Padding="16"
                        Background="White"
                        BorderBrush="#FFE1E6EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#FF1F2933"
                                Text="返回数据明细" />
                            <Border
                                Margin="10,0,0,0"
                                Padding="10,4"
                                HorizontalAlignment="Right"
                                Background="#FFF0FFF4"
                                CornerRadius="999"
                                DockPanel.Dock="Right">
                                <TextBlock
                                    Foreground="#FF2F855A"
                                    Text="{Binding PackProduceItems.Count, StringFormat=共 {0} 条}" />
                            </Border>
                        </DockPanel>

                        <DataGrid
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding PackProduceItems}"
                            SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding SpecificationId}" Header="SpecificationId" Width="150" />
                                <DataGridTextColumn Binding="{Binding SpecificationDescription}" Header="SpecificationDescription" Width="220" />
                                <DataGridTextColumn Binding="{Binding ItemName}" Header="ItemName" Width="180" />
                                <DataGridTextColumn Binding="{Binding CollectSN}" Header="CollectSN" Width="170" />
                                <DataGridTextColumn Binding="{Binding LotSN}" Header="LotSN" Width="170" />
                                <DataGridTextColumn Binding="{Binding CreateDate, StringFormat=yyyy-MM-dd HH:mm:ss}" Header="CreateDate" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Margin="0,0,10,0"
                        Padding="16"
                        Background="White"
                        BorderBrush="#FFE1E6EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#FF1F2933"
                            Text="异常与调试信息" />

                        <TextBox
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Background="#FFF8FAFC"
                            BorderBrush="#FFD9E2EC"
                            BorderThickness="1"
                            IsReadOnly="True"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="260" />
                        <RowDefinition Height="380" />
                    </Grid.RowDefinitions>

                    <Border
                        Margin="0,0,0,10"
                        Padding="16"
                        Background="White"
                        BorderBrush="#FFE1E6EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#FF1F2933"
                            Text="选中记录详情" />

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="{Binding SelectedItem.SpecificationId, StringFormat=规格ID: {0}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedItem.SpecificationDescription, StringFormat=规格描述: {0}}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedItem.ItemName, StringFormat=项目名: {0}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedItem.CollectSN, StringFormat=采集SN: {0}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedItem.LotSN, StringFormat=批次号: {0}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedItem.CreateDate, StringFormat=创建时间: {0:yyyy-MM-dd HH:mm:ss}}" />
                        </StackPanel>
                    </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Padding="16"
                        Background="White"
                        BorderBrush="#FFE1E6EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#FF1F2933"
                            Text="原始 JSON" />

                        <TextBox
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Background="#FF0B1F33"
                            BorderThickness="0"
                            FontFamily="Consolas"
                            Foreground="#FFD9E2EC"
                            IsReadOnly="True"
                            Text="{Binding ResponseRawJson}"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
