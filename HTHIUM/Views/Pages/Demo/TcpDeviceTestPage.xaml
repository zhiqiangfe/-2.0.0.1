<Page
    x:Class="HTHIUM.Views.Pages.Demo.TcpDeviceTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TCP 设备测试"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1B2A41" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF61758A" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF1B2A41" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </Page.Resources>

    <Grid Background="#FFF7F9FC" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <!-- 顶部标题与操作区 -->
        <Border Padding="14" Background="White" BorderBrush="#FFE1E7EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TCP 设备测试" FontSize="22" FontWeight="Bold" Foreground="#FF1B2A41" />
                    <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" Foreground="#FF61758A" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="96" Height="34" Margin="0,0,8,0" Content="重新加载" Command="{Binding ReloadCommand}" />
                    <Button Width="96" Height="34" Margin="0,0,8,0" Content="连接" Command="{Binding ConnectCommand}" />
                    <Button Width="96" Height="34" Margin="0,0,8,0" Content="断开" Command="{Binding DisconnectCommand}" />
                    <Button Width="96" Height="34" Content="清空日志" Command="{Binding ClearMessagesCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中间内容区 -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：控制与详情 -->
            <Border Padding="12" Background="White" BorderBrush="#FFE1E7EF" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 设备选择 -->
                        <TextBlock Text="当前设备" Style="{StaticResource SectionHeaderStyle}" />
                        <ComboBox Margin="0,10,0,12" Height="34"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="Name" />

                        <!-- 发送区 -->
                        <TextBlock Text="发送内容" Style="{StaticResource LabelStyle}" />
                        <TextBox Margin="0,0,0,10" Height="80"
                                 Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap" />
                        <Button Height="36" Content="发送" Command="{Binding SendCommand}" />

                        <!-- 设备详情 -->
                        <TextBlock Text="设备详情" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,8" />
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDevice.ID}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="名称:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.Name}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="类型:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.DeviceType}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="IP / 端口:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDeviceEndpoint}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="编码 / 换行:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDeviceEncodingInfo}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="心跳间隔:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDeviceHeartbeatText}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="自动连接:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedDeviceAutoConnectText}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="连接状态:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedDeviceConnectedText}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="最后发送:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedDevice.LastSentTime, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Style="{StaticResource ValueStyle}" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="最后接收:" Style="{StaticResource LabelStyle}" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedDevice.LastReceivedTime, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Style="{StaticResource ValueStyle}" />
                        </Grid>

                        <TextBlock Text="未选择设备" Foreground="#FF61758A" Margin="0,20,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNoDeviceSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：设备列表 -->
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="12" Background="White" BorderBrush="#FFE1E7EF" BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50" />
                        <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="140" />
                        <DataGridTextColumn Header="类型" Binding="{Binding DeviceType}" Width="100" />
                        <DataGridTextColumn Header="IP 地址" Binding="{Binding Config.IP}" Width="130" />
                        <DataGridTextColumn Header="端口" Binding="{Binding Config.Port}" Width="70" />
                        <DataGridTextColumn Header="编码" Binding="{Binding Config.EncodingName}" Width="80" />
                        <DataGridTextColumn Header="换行" Binding="{Binding Config.NewLine}" Width="70" />
                        <DataGridTextColumn Header="心跳间隔(ms)" Binding="{Binding Config.HeartbeatIntervalMs}" Width="100" />
                        <DataGridCheckBoxColumn Header="已连接" Binding="{Binding IsConnected}" Width="70" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100" />
                        <DataGridTextColumn Header="最后发送" Binding="{Binding LastSentTime, StringFormat=HH:mm:ss.fff}" Width="100" />
                        <DataGridTextColumn Header="最后接收" Binding="{Binding LastReceivedTime, StringFormat=HH:mm:ss.fff}" Width="100" />
                        <DataGridTextColumn Header="发送次数" Binding="{Binding SentCount}" Width="80" />
                        <DataGridTextColumn Header="接收次数" Binding="{Binding ReceivedCount}" Width="80" />
                        <DataGridTextColumn Header="错误次数" Binding="{Binding ErrorCount}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- 底部：消息日志 -->
        <Border Grid.Row="2" Padding="12" Background="White" BorderBrush="#FFE1E7EF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="通讯日志" FontSize="14" FontWeight="SemiBold" Foreground="#FF1B2A41" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" FontFamily="Consolas" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Page>
