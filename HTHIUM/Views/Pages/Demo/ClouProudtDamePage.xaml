<Page
    x:Class="HTHIUM.Views.Pages.Demo.ClouProudtDamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ClouProudtDamePage"
    d:DesignHeight="920"
    d:DesignWidth="1480"
    mc:Ignorable="d">

    <Grid Background="#F3F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Margin="18,18,18,12"
            Padding="20"
            Background="#132238"
            CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="电芯上料界面" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="#C6D2E1"
                        Text="实时查看 PLC / MES 状态、生产数据、配方、产量与日志信息。" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="#90A4BC"
                        Text="Last Update" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding LastUpdateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,0,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Margin="0,0,12,0"
                Padding="16"
                Background="White"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel>
                    <TextBlock Foreground="#5B6B7F" Text="PLC Connection" />
                    <Border
                        Margin="0,10,0,0"
                        Padding="10,5"
                        Background="{Binding PlcStatusBrush}"
                        CornerRadius="999"
                        HorizontalAlignment="Left">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding PlcStatusText}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0,0,12,0"
                Padding="16"
                Background="White"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel>
                    <TextBlock Foreground="#5B6B7F" Text="MES Connection" />
                    <Border
                        Margin="0,10,0,0"
                        Padding="10,5"
                        Background="{Binding MesStatusBrush}"
                        CornerRadius="999"
                        HorizontalAlignment="Left">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding MesStatusText}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Margin="0,0,12,0"
                Padding="16"
                Background="White"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel>
                    <TextBlock Foreground="#5B6B7F" Text="Recipe Name" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#17324D"
                        Text="{Binding RecipeName}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="3"
                Margin="0,0,12,0"
                Padding="16"
                Background="White"
                BorderBrush="#D9E1EA"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel>
                    <TextBlock Foreground="#5B6B7F" Text="Today Output" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#17324D"
                        Text="{Binding TodayOutput}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Height="40"
                    Padding="16,10"
                    Background="#2E7D32"
                    BorderThickness="0"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh"
                    Foreground="White" />
                <Button
                    Margin="0,0,10,0"
                    Height="40"
                    Padding="16,10"
                    Background="#1D4ED8"
                    BorderThickness="0"
                    Command="{Binding ToggleAutoRefreshCommand}"
                    Content="{Binding IsAutoRefreshEnabled, StringFormat=Auto: {0}}"
                    Foreground="White" />
                <Button
                    Padding="16,10"
                    Height="40"
                    Background="#6B7280"
                    BorderThickness="0"
                    Command="{Binding ClearLogCommand}"
                    Content="Clear Logs"
                    Foreground="White" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="18,0,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Margin="0,0,12,0"
                        Padding="16"
                        Background="White"
                        BorderBrush="#D9E1EA"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel>
                            <TextBlock Foreground="#5B6B7F" Text="Current Barcode" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#17324D"
                                Text="{Binding CurrentBarcode}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        Padding="16"
                        Background="White"
                        BorderBrush="#D9E1EA"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel>
                            <TextBlock Foreground="#5B6B7F" Text="OK Count" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#17324D"
                                Text="{Binding OkCount}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Margin="0,0,12,0"
                        Padding="16"
                        Background="White"
                        BorderBrush="#D9E1EA"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel>
                            <TextBlock Foreground="#5B6B7F" Text="NG Count" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#B42318"
                                Text="{Binding NgCount}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="3"
                        Padding="16"
                        Background="White"
                        BorderBrush="#D9E1EA"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel>
                            <TextBlock Foreground="#5B6B7F" Text="Yield Rate" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#17324D"
                                Text="{Binding YieldRate, StringFormat={}{0:F2}%}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="1"
                    Padding="16"
                    Background="White"
                    BorderBrush="#D9E1EA"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#17324D"
                            Text="生产数据表" />

                        <DataGrid
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding ProductionRecords}"
                            SelectedItem="{Binding SelectedRecord}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Barcode}" Header="条码" Width="190" />
                                <DataGridTextColumn Binding="{Binding Parameter1, StringFormat={}{0:F2}}" Header="参数1" Width="90" />
                                <DataGridTextColumn Binding="{Binding Parameter2, StringFormat={}{0:F2}}" Header="参数2" Width="90" />
                                <DataGridTextColumn Binding="{Binding Parameter3, StringFormat={}{0:F3}}" Header="参数3" Width="90" />
                                <DataGridTextColumn Binding="{Binding Result}" Header="结果" Width="80" />
                                <DataGridTextColumn Binding="{Binding Station}" Header="工站" Width="110" />
                                <DataGridTextColumn Binding="{Binding Recipe}" Header="配方" Width="140" />
                                <DataGridTextColumn Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Header="时间" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="270" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    Background="White"
                    BorderBrush="#D9E1EA"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#17324D"
                            Text="当前选中数据" />

                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Text="{Binding SelectedRecord.Barcode, StringFormat=条码: {0}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedRecord.Parameter1, StringFormat=参数1: {0:F2}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedRecord.Parameter2, StringFormat=参数2: {0:F2}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedRecord.Parameter3, StringFormat=参数3: {0:F3}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedRecord.Result, StringFormat=结果: {0}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedRecord.Recipe, StringFormat=配方: {0}}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedRecord.Timestamp, StringFormat=时间: {0:yyyy-MM-dd HH:mm:ss}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="16"
                    Background="White"
                    BorderBrush="#D9E1EA"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#17324D"
                            Text="日志信息" />

                        <DataGrid
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding OperationLogs}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Header="时间" Width="90" />
                                <DataGridTextColumn Binding="{Binding Level}" Header="级别" Width="70" />
                                <DataGridTextColumn Binding="{Binding Message}" Header="内容" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
