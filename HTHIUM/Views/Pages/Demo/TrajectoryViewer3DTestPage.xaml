<Page
    x:Class="HTHIUM.Views.Pages.Demo.TrajectoryViewer3DTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HTHIUM.Views.Pages.Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:HTHIUM.Component.UserControls;assembly=HTHIUM.Component"
    Title="TrajectoryViewer3DTestPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <uc:TrajectoryViewer3D
            AxisLabelFontSize="{Binding AxisLabelFontSize}"
            ChartTitle="{Binding ChartTitle}"
            GridThickness="{Binding GridThickness}"
            IsShowLegend="True"
            SelectedTrajectory="{Binding SelectedTrajectory}"
            ThresholdBoxCenter="{Binding ThresholdBoxCenter}"
            ThresholdBoxHalfHeight="{Binding ThresholdBoxHalfHeight}"
            ThresholdBoxHalfLength="{Binding ThresholdBoxHalfLength}"
            ThresholdBoxHalfWidth="{Binding ThresholdBoxHalfWidth}"
            TickLength="{Binding TickLength}"
            TrajectoriesSource="{Binding Trajectories}"
            TrajectoryClickCommand="{Binding TrajectoryClickCommand}"
            XAxisRange="{Binding XAxisRange}"
            XAxisStep="{Binding GridStep}"
            XLabel="{Binding XLabel}"
            YAxisRange="{Binding YAxisRange}"
            YAxisStep="{Binding GridStep}"
            YLabel="{Binding YLabel}"
            ZAxisRange="{Binding ZAxisRange}"
            ZAxisStep="{Binding GridStep}"
            ZLabel="{Binding ZLabel}" />
    </Grid>
</Page>
