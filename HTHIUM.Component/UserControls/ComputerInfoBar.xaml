<UserControl
    x:Class="HTHIUM.Component.UserControls.ComputerInfoBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:HTHIUM.Component.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <DockPanel>
                <iconPacks:PackIconFontaudio
                    DockPanel.Dock="Left"
                    Kind="Cpu"
                    ToolTip="CPU占用率" />
                <TextBlock
                    x:Name="CPULoadText"
                    Margin="5,0"
                    d:Text="10%" />
            </DockPanel>
            <DockPanel>
                <iconPacks:PackIconBootstrapIcons
                    DockPanel.Dock="Left"
                    Kind="Memory"
                    ToolTip="内存占用" />
                <TextBlock
                    x:Name="MemoryLoadText"
                    Margin="5,0"
                    d:Text="100 MB" />
            </DockPanel>
            <DockPanel>
                <iconPacks:PackIconBootstrapIcons
                    DockPanel.Dock="Left"
                    Kind="GpuCard"
                    ToolTip="GPU占用率" />
                <TextBlock
                    x:Name="GPULoadText"
                    Margin="5,0"
                    d:Text="10%" />
            </DockPanel>
            <DockPanel>
                <iconPacks:PackIconLucide
                    DockPanel.Dock="Left"
                    Kind="ArrowUpDown"
                    ToolTip="IO读/写速度" />
                <TextBlock
                    x:Name="IORWRateText"
                    Margin="5,0"
                    d:Text="1 MB/s" />
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
