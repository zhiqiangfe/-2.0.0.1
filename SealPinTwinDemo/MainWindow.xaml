<Window x:Class="SealPinTwinDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="锂电池密封钉焊接设备内部动作数字孪生"
        Width="1280" Height="760" MinWidth="1000" MinHeight="620"
        WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#07101C">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="128"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0C1725" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#0F766E">
                        <TextBlock Text="Li+" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="密封钉焊接设备内部动作数字孪生" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="进机移载 · 定位夹紧 · 清洗装钉 · 激光焊接 · 检测出机"
                                   Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#122A35" CornerRadius="5" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#26D9C7" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ConnectionText" Text="模拟 PLC 已连接" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ClockText" Margin="15,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RunButton" Content="暂停产线" Click="RunButton_Click"/>
                    <Button Content="模拟焊接异常" Background="#7F1D1D" BorderBrush="#B91C1C"
                            Click="FaultButton_Click"/>
                    <Button Content="复位" Click="ResetButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="255"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="12,12,6,8" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="单机动作循环" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Grid.Row="1" Text="点击动作定位设备内部机构" Margin="0,3,0,10"
                               Foreground="{StaticResource TextMuted}" FontSize="10"/>
                    <ListBox Grid.Row="2" x:Name="StepList" ItemsSource="{Binding Steps}"
                             SelectionChanged="StepList_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16263A" CornerRadius="6" BorderBrush="#29415E"
                                        BorderThickness="1" Padding="9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="31"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="25" Height="25" CornerRadius="13" Background="{Binding StateBrush}">
                                            <TextBlock Text="{Binding Code}" FontSize="9" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,0">
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Device}" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                                   FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="3" Background="#0A1522" CornerRadius="6" Padding="9">
                        <TextBlock Text="参考真实设备工艺，三维模型为教学用途原创简化模型。"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="6,12,6,8" Background="#050D17"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <h:HelixViewport3D x:Name="Viewport" Background="#050D17"
                                       ShowCoordinateSystem="True" ShowViewCube="True"
                                       ShowFrameRate="True" ZoomExtentsWhenLoaded="False"
                                       IsHeadLightEnabled="False">
                        <h:SunLight/>
                    </h:HelixViewport3D>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                            Background="#D90C1725" CornerRadius="6" Padding="10,7">
                        <StackPanel>
                            <TextBlock x:Name="SceneTitle" Text="密封钉焊接单机内部" FontWeight="SemiBold"/>
                            <TextBlock Text="左键旋转 · 右键平移 · 滚轮缩放"
                                       Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="14"
                            Background="#D90C1725" CornerRadius="6" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="当前工序  " Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="CurrentStepText" Text="上料定位" Foreground="#26D9C7" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Margin="14">
                        <Button x:Name="FollowButton" Content="停止跟随" Click="FollowCellButton_Click"
                                Background="#0F766E" BorderBrush="#14B8A6"/>
                        <Button Content="焊接特写" Click="WeldCloseViewButton_Click"/>
                        <Button x:Name="LabelButton" Content="显示标注" Click="ToggleLabelsButton_Click"/>
                        <Button Content="全景" Click="HomeViewButton_Click"/>
                        <Button Content="俯视" Click="TopViewButton_Click"/>
                        <Button Content="正视" Click="FrontViewButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="6,12,12,8" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="实时焊接参数" FontWeight="SemiBold" FontSize="15"/>
                        <UniformGrid Columns="2" Margin="0,10,0,12">
                            <Border Background="{StaticResource Panel2}" CornerRadius="6" Margin="0,0,4,4" Padding="9">
                                <StackPanel>
                                    <TextBlock Text="激光功率" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock x:Name="PowerText" Text="2000 W" FontSize="18" Foreground="#26D9C7"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Panel2}" CornerRadius="6" Margin="4,0,0,4" Padding="9">
                                <StackPanel>
                                    <TextBlock Text="焊接速度" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock x:Name="SpeedText" Text="85 mm/s" FontSize="18"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Panel2}" CornerRadius="6" Margin="0,4,4,0" Padding="9">
                                <StackPanel>
                                    <TextBlock Text="保护气流量" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock x:Name="GasText" Text="18.0 L/min" FontSize="16"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Panel2}" CornerRadius="6" Margin="4,4,0,0" Padding="9">
                                <StackPanel>
                                    <TextBlock Text="焦点偏差" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock x:Name="FocusText" Text="+0.02 mm" FontSize="16"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="质量判定" FontWeight="SemiBold" Margin="0,5,0,8"/>
                        <Border Background="#0A1522" CornerRadius="7" Padding="11">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="焊缝完整率" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                    <TextBlock x:Name="SeamText" Text="99.6%" HorizontalAlignment="Right" Foreground="#26D9C7"/>
                                </Grid>
                                <ProgressBar x:Name="SeamBar" Value="99.6" Maximum="100" Height="6"
                                             Foreground="#26D9C7" Background="#24364C"/>
                                <Grid Margin="0,10,0,4">
                                    <TextBlock Text="同轴视觉偏差" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                    <TextBlock x:Name="VisionOffsetText" Text="0.018 mm" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="当前判定" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                    <Border x:Name="JudgeBadge" HorizontalAlignment="Right" Background="#14532D"
                                            CornerRadius="4" Padding="8,2">
                                        <TextBlock x:Name="JudgeText" Text="OK" Foreground="#86EFAC" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="生产统计" FontWeight="SemiBold" Margin="0,15,0,8"/>
                        <Border Background="{StaticResource Panel2}" CornerRadius="7" Padding="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="今日产量" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock x:Name="OutputText" Text="2,418" FontSize="20"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="一次合格率" Foreground="{StaticResource TextMuted}" FontSize="9"/>
                                    <TextBlock x:Name="FpyText" Text="99.31%" FontSize="20" Foreground="#60A5FA"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="当前电芯模型" FontWeight="SemiBold" Margin="0,15,0,8"/>
                        <Border Background="#0A1522" CornerRadius="7" Padding="10">
                            <StackPanel>
                                <TextBlock Text="海辰 ∞Cell 1175Ah" Foreground="#26D9C7" FontWeight="SemiBold"/>
                                <TextBlock Text="MC1175P025A · LFP" Foreground="#7DD3FC" FontFamily="Consolas"
                                           FontSize="10" Margin="0,3,0,0"/>
                                <TextBlock Text="580.22 × 75.22 × 216.31 mm"
                                           Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0"/>
                                <TextBlock Text="3.2 V · 3760 Wh · 20.4 kg"
                                           Foreground="{StaticResource TextMuted}" FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="数字孪生数据链" FontWeight="SemiBold" Margin="0,15,0,8"/>
                        <Border Background="#0A1522" CornerRadius="7" Padding="10">
                            <StackPanel>
                                <TextBlock Text="SIM.PLC.SEAL_PIN_01" Foreground="#7DD3FC" FontFamily="Consolas"/>
                                <TextBlock Text="100 ms 刷新 · 32 个模拟标签 · 本地离线运行"
                                           Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="12,0,12,12" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8">
            <Grid Margin="14,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="实时事件" FontWeight="SemiBold"/>
                    <TextBlock Text="最近 5 条" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextMuted}" FontSize="10"/>
                </Grid>
                <ListBox Grid.Row="1" x:Name="EventList" ItemsSource="{Binding Events}"
                         Background="Transparent" BorderThickness="0" IsHitTestVisible="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="#7DD3FC" FontSize="10"/>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="10"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
