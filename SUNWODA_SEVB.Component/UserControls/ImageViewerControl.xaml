<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.ImageViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <ToolBar Grid.Row="0">
            <Button
                Name="btnZoomIn"
                Click="BtnZoomIn_Click"
                Content="放大" />
            <Button
                Name="btnZoomOut"
                Click="BtnZoomOut_Click"
                Content="缩小" />
            <Button
                Name="btnFitWindow"
                Click="BtnFitWindow_Click"
                Content="适应窗口" />
            <Button
                Name="btnReset"
                Click="BtnReset_Click"
                Content="重置" />
            <Separator />
            <ComboBox Name="cmbDocking" SelectionChanged="CmbDocking_SelectionChanged">
                <ComboBoxItem Content="居中" IsSelected="True" />
                <ComboBoxItem Content="靠上" />
                <ComboBoxItem Content="靠下" />
                <ComboBoxItem Content="靠左" />
                <ComboBoxItem Content="靠右" />
            </ComboBox>
            <Separator />
            <ToggleButton Name="btnAnnotateText" Content="文字标注" />
            <ToggleButton Name="btnAnnotateRect" Content="矩形标注" />
            <ToggleButton Name="btnAnnotateCircle" Content="圆形标注" />
            <Button
                Name="btnClearAnnotations"
                Click="BtnClearAnnotations_Click"
                Content="清除标注" />
        </ToolBar>

        <!--  图片显示区域  -->
        <ScrollViewer
            Name="scrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
            VerticalScrollBarVisibility="Hidden">
            <Grid
                Name="imageContainer"
                MouseLeftButtonDown="ImageContainer_MouseLeftButtonDown"
                MouseLeftButtonUp="ImageContainer_MouseLeftButtonUp"
                MouseMove="ImageContainer_MouseMove"
                MouseRightButtonDown="ImageContainer_MouseRightButtonDown">
                <Image Name="imageDisplay" RenderOptions.BitmapScalingMode="HighQuality" />
                <Canvas
                    Name="annotationCanvas"
                    Background="Transparent"
                    IsHitTestVisible="True" />
            </Grid>
        </ScrollViewer>

        <!--  信息栏  -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="txtImageInfo" Text="无图片" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Name="txtZoomLevel" Text="缩放: 100%" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Name="txtMousePosition" Text="X: 0, Y: 0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
