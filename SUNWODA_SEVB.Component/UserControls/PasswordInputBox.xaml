<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.PasswordInputBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="50"
    d:DesignWidth="400"
    BorderBrush="#e0e0e0"
    BorderThickness="0"
    mc:Ignorable="d">
    <Grid>
        <hc:PasswordBox
            x:Name="passwordBox"
            BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=BorderBrush}"
            ButtonBase.Click="passwordBox_Click"
            PasswordBox.PasswordChanged="passwordBox_PasswordChanged"
            ShowEyeButton="True"
            TextBoxBase.TextChanged="passwordBox_PasswordChanged" />
    </Grid>
</UserControl>
