<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.TrajectoryViewer3D"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <!--  3D视图  -->
        <helix:HelixViewport3D
            x:Name="viewport"
            Grid.Row="1"
            Background="White"
            InfoBackground="Transparent"
            ShowCameraInfo="False"
            ShowCoordinateSystem="False"
            ShowFrameRate="False"
            ShowViewCube="False">
            <!--  相机  -->
            <helix:HelixViewport3D.Camera>
                <PerspectiveCamera
                    FieldOfView="45"
                    LookDirection="-7,-3,-4"
                    Position="70,15,20"
                    UpDirection="0.3,0.5,0.8" />
            </helix:HelixViewport3D.Camera>

            <!--  默认灯光  -->
            <!--<helix:DefaultLights />-->
            <helix:SunLight />
        </helix:HelixViewport3D>

        <TextBlock
            x:Name="Title"
            Margin="0,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            d:Text="3D曲线图"
            Background="Transparent" />

        <StackPanel
            x:Name="Legend"
            Margin="0,0,50,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <StackPanel
                x:Name="LegendThresholdBox"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Viewport3D
                    Width="100"
                    Height="50"
                    HorizontalAlignment="Left">

                    <Viewport3D.Camera>
                        <PerspectiveCamera
                            FieldOfView="60"
                            LookDirection="-3,-3,-5"
                            Position="3,3,5"
                            UpDirection="0,1,0" />
                    </Viewport3D.Camera>

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <DirectionalLight Direction="-1,-1,-2" Color="White" />
                        </ModelVisual3D.Content>
                    </ModelVisual3D>

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="-1,-0.5,-1   1,-0.5,-1   1,0.5,-1   -1,0.5,-1                                            -1,-0.5,1     1,-0.5,1    1,0.5,1    -1,0.5,1" TriangleIndices="0 1 2 0 2 3                                                   4 6 5 4 7 6                                                   0 4 5 0 5 1                                                   1 5 6 1 6 2                                                   2 6 7 2 7 3                                                   3 7 4 3 4 0" />
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial>
                                        <DiffuseMaterial.Brush>
                                            <SolidColorBrush Opacity="0.6" Color="#96646464" />
                                        </DiffuseMaterial.Brush>
                                    </DiffuseMaterial>
                                </GeometryModel3D.Material>
                            </GeometryModel3D>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                </Viewport3D>
                <TextBlock
                    x:Name="LegendThresholdBoxLabel"
                    VerticalAlignment="Center"
                    Text="阈值范围" />
            </StackPanel>

            <StackPanel
                x:Name="LegendThresholdWarnLine"
                Margin="0,10,0,0"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Viewport3D
                    Width="100"
                    Height="10"
                    HorizontalAlignment="Left">
                    <Viewport3D.Camera>
                        <PerspectiveCamera
                            FieldOfView="60"
                            LookDirection="0, 0, -5"
                            Position="0, 0, 5"
                            UpDirection="0, 1, 0" />
                    </Viewport3D.Camera>

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <DirectionalLight Direction="-0.2,-0.3,-1" Color="White" />
                        </ModelVisual3D.Content>
                    </ModelVisual3D>


                    <!--  红色线条  -->

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <GeometryModel3D>
                                <GeometryModel3D.Geometry>
                                    <MeshGeometry3D Positions="-1,0,-1   1,0,-1   1,0.2,-1   -1,0.2,-1" TriangleIndices="0 1 2 0 2 3" />
                                </GeometryModel3D.Geometry>
                                <GeometryModel3D.Material>
                                    <DiffuseMaterial Brush="Red" />
                                </GeometryModel3D.Material>
                                <GeometryModel3D.BackMaterial>
                                    <DiffuseMaterial Brush="Red" />
                                </GeometryModel3D.BackMaterial>
                            </GeometryModel3D>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                </Viewport3D>
                <TextBlock x:Name="LegendThresholdWarnLineLabel" Text="超出安全阈值" />
            </StackPanel>
            <StackPanel x:Name="LegendLines" />
        </StackPanel>


    </Grid>
</UserControl>
