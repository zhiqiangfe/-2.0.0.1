<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.ModelViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <ToolBar
            x:Name="TestToolBar"
            Grid.Row="0"
            Visibility="Collapsed">
            <Button Name="BtnLoadModel" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="加载模型" />
                </StackPanel>
            </Button>
            <Button Name="BtnClearAll" Padding="5">
                <TextBlock VerticalAlignment="Center" Text="清空所有" />
            </Button>
            <Separator />
            <Button Name="BtnResetView" Padding="5">
                <TextBlock VerticalAlignment="Center" Text="重置视图" />
            </Button>
            <Separator />
            <Button
                Name="BtnRemoveModel"
                Margin="5,0,2,0"
                Padding="5">
                <TextBlock VerticalAlignment="Center" Text="删除模型" />
            </Button>
            <Button Name="BtnCenterModel" Padding="5">
                <TextBlock VerticalAlignment="Center" Text="模型居中" />
            </Button>
            <Separator />

            <!--  位置设置  -->
            <TextBlock
                Margin="5,0,2,0"
                VerticalAlignment="Center"
                Text="位置: X:" />
            <TextBox
                Name="TxtPosX"
                Width="50"
                VerticalAlignment="Center"
                Text="0" />
            <TextBlock
                Margin="5,0,2,0"
                VerticalAlignment="Center"
                Text="Y:" />
            <TextBox
                Name="TxtPosY"
                Width="50"
                VerticalAlignment="Center"
                Text="0" />
            <TextBlock
                Margin="5,0,2,0"
                VerticalAlignment="Center"
                Text="Z:" />
            <TextBox
                Name="TxtPosZ"
                Width="50"
                VerticalAlignment="Center"
                Text="0" />

            <Separator />

            <!--  旋转设置  -->
            <TextBlock
                Margin="5,0,2,0"
                VerticalAlignment="Center"
                Text="旋转: X:" />
            <TextBox
                Name="TxtRotX"
                Width="50"
                VerticalAlignment="Center"
                Text="0" />
            <TextBlock
                Margin="5,0,2,0"
                VerticalAlignment="Center"
                Text="Y:" />
            <TextBox
                Name="TxtRotY"
                Width="50"
                VerticalAlignment="Center"
                Text="0" />
            <TextBlock
                Margin="5,0,2,0"
                VerticalAlignment="Center"
                Text="Z:" />
            <TextBox
                Name="TxtRotZ"
                Width="50"
                VerticalAlignment="Center"
                Text="0" />

            <Separator />

            <!--  缩放设置  -->
            <TextBlock
                Margin="5,0,2,0"
                VerticalAlignment="Center"
                Text="缩放:" />
            <TextBox
                Name="TxtScale"
                Width="50"
                VerticalAlignment="Center"
                Text="1" />
        </ToolBar>

        <!--  3D视图  -->
        <helix:HelixViewport3D
            x:Name="viewport"
            Grid.Row="1"
            Background="#ececec"
            InfoBackground="Transparent"
            ShowCameraInfo="False"
            ShowCoordinateSystem="False"
            ShowFrameRate="False"
            ShowViewCube="False">
            <!--  相机  -->
            <helix:HelixViewport3D.Camera>
                <PerspectiveCamera
                    FieldOfView="45"
                    LookDirection="-7,-3,-4"
                    Position="5,5,5"
                    UpDirection="0,0,1" />
            </helix:HelixViewport3D.Camera>

            <!--  默认灯光  -->
            <helix:DefaultLights />

            <!--  网格  -->
            <helix:GridLinesVisual3D
                x:Name="GridLine"
                Width="100"
                Length="100"
                MajorDistance="10"
                MinorDistance="1"
                Visible="False" />
        </helix:HelixViewport3D>
    </Grid>
</UserControl>
