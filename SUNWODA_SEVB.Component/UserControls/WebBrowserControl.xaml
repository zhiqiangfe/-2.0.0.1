<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.WebBrowserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  可选的导航栏  -->
        <Border
            x:Name="NavigationBar"
            Grid.Row="0"
            Background="#F5F5F5"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    Width="30"
                    Margin="0,0,5,0"
                    Click="BackButton_Click"
                    Content="←" />
                <Button
                    x:Name="ForwardButton"
                    Grid.Column="1"
                    Width="30"
                    Margin="0,0,5,0"
                    Click="ForwardButton_Click"
                    Content="→" />
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    Width="30"
                    Margin="0,0,5,0"
                    Click="RefreshButton_Click"
                    Content="🔄" />
                <TextBox
                    x:Name="AddressBar"
                    Grid.Column="3"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    KeyDown="AddressBar_KeyDown" />
                <Button
                    x:Name="GoButton"
                    Grid.Column="4"
                    Width="40"
                    Click="GoButton_Click"
                    Content="Go" />
            </Grid>
        </Border>

        <!--  WebView2控件  -->
        <Border x:Name="WebViewBorder" Grid.Row="1">
            <wv2:WebView2 x:Name="webView" />
        </Border>

        <!--  加载提示  -->
        <Grid
            x:Name="LoadingPanel"
            Grid.Row="1"
            Background="White"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="200"
                    Height="20"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Text="正在加载..." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
