<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.CustomControls">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="ThinkingContainerStyle" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FFE3F2FD" />
                    <GradientStop Offset="1" Color="#FFBBDEFB" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#FF2196F3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Opacity" Value="0" />
    </Style>

    <Style x:Key="ToggleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="4" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:AiMarkdownViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AiMarkdownViewer}">
                    <Border
                        x:Name="PART_MainBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="PART_ThinkingContainer"
                                Grid.Row="0"
                                Style="{StaticResource ThinkingContainerStyle}"
                                Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Path
                                                Width="20"
                                                Height="20"
                                                Margin="0,0,8,0"
                                                Data="M12,2C17.52,2 22,6.48 22,12C22,17.52 17.52,22 12,22C6.48,22 2,17.52 2,12C2,6.48 6.48,2 12,2M12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C16.42,20 20,16.42 20,12C20,7.58 16.42,4 12,4M12,6C15.31,6 18,8.69 18,12C18,15.31 15.31,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6M12,8C9.79,8 8,9.79 8,12C8,14.21 9.79,16 12,16C14.21,16 16,14.21 16,12C16,9.79 14.21,8 12,8Z"
                                                Fill="#FF2196F3"
                                                Stretch="Fill">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ThinkingIconRotation" CenterX="10" CenterY="10" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="#FF1976D2"
                                                Text="深度思考..." />
                                        </StackPanel>

                                        <Button
                                            x:Name="PART_ThinkingToggleButton"
                                            Grid.Column="1"
                                            Style="{StaticResource ToggleButtonStyle}">
                                            <Path
                                                Width="12"
                                                Height="12"
                                                Fill="#FF1976D2"
                                                Stretch="Fill">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="M7,10L12,15L17,10H7Z" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThinkingExpanded, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                                                <Setter Property="Data" Value="M7,14L12,9L17,14H7Z" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>
                                    </Grid>

                                    <ScrollViewer
                                        x:Name="PART_ThinkingScrollViewer"
                                        Grid.Row="2"
                                        MaxHeight="150"
                                        Margin="0,2,0,0"
                                        VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Style>
                                            <Style TargetType="ScrollViewer">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Height" Value="Auto" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThinkingExpanded, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Height" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ScrollViewer.Style>
                                        <TextBlock
                                            x:Name="PART_ThinkingText"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="#FF424242"
                                            LineHeight="18"
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <FlowDocumentScrollViewer
                                x:Name="PART_DocumentViewer"
                                Grid.Row="1"
                                BorderBrush="Transparent"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <FlowDocumentScrollViewer.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0,5,0,5" />
                                        <Setter Property="LineHeight" Value="22" />
                                    </Style>
                                </FlowDocumentScrollViewer.Resources>
                            </FlowDocumentScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>