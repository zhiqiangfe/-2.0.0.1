<Window
    x:Class="SUNWODA_SEVB.Views.Windows.Common.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Windows.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="MainWindow"
    Width="800"
    Height="450"
    WindowState="Maximized"
    mc:Ignorable="d">
    <!--  添加资源和转换器  -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!--  左侧导航栏  -->

        <Grid Grid.Column="0" Background="#FF2C3E50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  Logo区域  -->

            <Border
                Grid.Row="0"
                Height="60"
                Background="#FF1A252F">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="White"
                    Text="单机数字化平台" />
            </Border>


            <!--  菜单列表  -->
            <!--<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl d:ItemsSource="{d:SampleData}" ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                GroupName="NavButtons"
                                IsChecked="{Binding IsSelected}">
                                <StackPanel Margin="20,10" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,10,0" Text="{Binding Icon}" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>-->
            <!--  菜单列表  -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl d:ItemsSource="{d:SampleData}" ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                GroupName="NavButtons"
                                IsChecked="{Binding IsSelected}"
                                IsEnabled="{Binding DataContext.IsNavigating, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border
                                                        x:Name="border"
                                                        Padding="10,8"
                                                        Background="Transparent"
                                                        BorderThickness="0">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FF34495E" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FF3498DB" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontSize" Value="14" />
                                    </Style>
                                </RadioButton.Style>
                                <StackPanel Margin="10,2" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,10,0" Text="{Binding Icon}" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>


            <!--  底部功能按钮  -->
            <!--

        <StackPanel Grid.Row="2" Margin="0,10">
            <RadioButton Command="{Binding SettingsCommand}" GroupName="NavButtons">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0" Text="⚙️" />
                    <TextBlock Text="设置" />
                </StackPanel>
            </RadioButton>
            <RadioButton Command="{Binding UserCommand}" GroupName="NavButtons">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0" Text="👤" />
                    <TextBlock Text="用户" />
                </StackPanel>
            </RadioButton>
        </StackPanel>-->

            <!--  底部功能按钮  -->
            <StackPanel Grid.Row="2" Margin="0,10">
                <RadioButton
                    Command="{Binding SettingsCommand}"
                    GroupName="NavButtons"
                    IsEnabled="{Binding IsNavigating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border
                                            x:Name="border"
                                            Padding="20,10"
                                            Background="Transparent"
                                            BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF34495E" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF3498DB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </RadioButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0" Text="⚙️" />
                        <TextBlock Text="设置" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    Command="{Binding UserCommand}"
                    GroupName="NavButtons"
                    IsEnabled="{Binding IsNavigating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border
                                            x:Name="border"
                                            Padding="20,10"
                                            Background="Transparent"
                                            BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF34495E" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF3498DB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </RadioButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0" Text="👤" />
                        <TextBlock Text="用户" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>


        <!--  右侧内容区  -->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <!--  顶部状态栏  -->
            <!--

        <Border
            Grid.Row="0"
            Height="40"
            Background="#FFF8F9FA"
            BorderBrush="#FFE0E0E0"
            BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock
                    Grid.Column="0"
                    Margin="20,0"
                    VerticalAlignment="Center"
                    Text="xxxxxx" />
            </Grid>
        </Border>-->

            <!--  顶部状态栏  -->
            <Border
                Grid.Row="0"
                Height="40"
                Background="#FFF8F9FA"
                BorderBrush="#FFE0E0E0"
                BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock
                        Grid.Column="0"
                        Margin="20,0"
                        VerticalAlignment="Center"
                        Text="{Binding LoadingMessage}" />

                    <!--  加载提示  -->
                    <!--<StackPanel
                    Margin="0,0,20,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Visibility="{Binding IsNavigating, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar
                        Width="100"
                        Height="16"
                        Margin="0,0,10,0"
                        IsIndeterminate="True" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding LoadingMessage}" />
                    </StackPanel>-->
                </Grid>
            </Border>


            <!--  主内容区 - Frame用于承载Page  -->
            <!--

        <Frame
            x:Name="NavigationFrame"
            Grid.Row="1"
            NavigationUIVisibility="Hidden" />-->

            <!--  主内容区 - Frame用于承载Page  -->
            <Grid Grid.Row="1">
                <Frame x:Name="NavigationFrame" NavigationUIVisibility="Hidden">
                    <Frame.Resources>
                        <!--  添加淡入淡出动画  -->
                        <Style TargetType="Frame">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Frame">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter x:Name="PART_FrameCP">
                                                <ContentPresenter.RenderTransform>
                                                    <TranslateTransform />
                                                </ContentPresenter.RenderTransform>
                                            </ContentPresenter>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Frame.Resources>
                </Frame>

                <!--  加载遮罩层  -->
                <!--<Border
                Background="White"
                Opacity="0.8"
                Visibility="{Binding IsNavigating, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar
                        Width="150"
                        Height="20"
                        Margin="0,0,0,10"
                        IsIndeterminate="True" />
                        <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Text="{Binding LoadingMessage}" />
                    </StackPanel>
                </Border>-->
            </Grid>
        </Grid>
    </Grid>
</Window>
