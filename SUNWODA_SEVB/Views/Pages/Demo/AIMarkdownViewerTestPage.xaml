<Page
    x:Class="SUNWODA_SEVB.Views.Pages.Demo.AIMarkdownViewerTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:SUNWODA_SEVB.Component.CustomControls;assembly=SUNWODA_SEVB.Component"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AIMarkdownViewerTestPage"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Background="#FFF7F9FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Margin="12,12,12,8"
            Padding="14"
            Background="White"
            BorderBrush="#FFE1E7EF"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="#FF1B2A41"
                        Text="PLC 地址调试台" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#FF61758A"
                        Text="查看已加载地址、当前值，并对选中地址执行手动写入或测试写入。" />
                </StackPanel>

                <WrapPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ItemHeight="40"
                    ItemWidth="130">
                    <Button
                        Margin="0,0,8,0"
                        Background="#FF1976D2"
                        BorderThickness="0"
                        Command="{Binding RefreshPlcDataCommand}"
                        Content="刷新地址"
                        Foreground="White" />
                    <Button
                        Margin="0,0,8,0"
                        Background="#FF2E7D32"
                        BorderThickness="0"
                        Command="{Binding WriteSelectedValueCommand}"
                        Content="写入输入值"
                        Foreground="White" />
                    <Button
                        Margin="0,0,8,0"
                        Background="#FFF57C00"
                        BorderThickness="0"
                        Command="{Binding WriteTestValueCommand}"
                        Content="写入测试值"
                        Foreground="White" />
                    <Button
                        Background="#FF5C6BC0"
                        BorderThickness="0"
                        Command="{Binding SimulateAiResponseCommand}"
                        Content="运行演示"
                        Foreground="White" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Margin="0,0,8,0"
                Padding="12"
                Background="White"
                BorderBrush="#FFE1E7EF"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#FF1B2A41"
                        Text="PLC 状态" />

                    <ListBox
                        Grid.Row="1"
                        Margin="0,10,0,14"
                        ItemsSource="{Binding ConnectionItems}"
                        SelectedItem="{Binding SelectedConnection}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="#FFF8FAFD"
                                    BorderBrush="#FFE4EAF1"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <DockPanel>
                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Fill="#FFD32F2F">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#FFD32F2F" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="True">
                                                            <Setter Property="Fill" Value="#FF2E7D32" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                Foreground="#FF61758A"
                                                Text="{Binding StatusName}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        Grid.Row="2"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#FF1B2A41"
                        Text="地址列表" />

                    <DataGrid
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding AddressItems}"
                        SelectedItem="{Binding SelectedAddress}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ParameterName}" Header="参数" Width="80" />
                            <DataGridTextColumn Binding="{Binding Address}" Header="地址" Width="80" />
                            <DataGridTextColumn Binding="{Binding MonitorValue}" Header="当前值" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0,0,8,0"
                Padding="12"
                Background="White"
                BorderBrush="#FFE1E7EF"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#FF1B2A41"
                        Text="选中地址详情" />

                    <UniformGrid Grid.Row="1" Margin="0,14,0,0" Columns="2">
                        <TextBlock Foreground="#FF61758A" Text="参数名" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedAddress.ParameterName}" />
                    </UniformGrid>
                    <UniformGrid Grid.Row="2" Margin="0,10,0,0" Columns="2">
                        <TextBlock Foreground="#FF61758A" Text="PLC ID" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedAddress.PlcId}" />
                    </UniformGrid>
                    <UniformGrid Grid.Row="3" Margin="0,10,0,0" Columns="2">
                        <TextBlock Foreground="#FF61758A" Text="地址" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedAddress.Address}" />
                    </UniformGrid>
                    <UniformGrid Grid.Row="4" Margin="0,10,0,0" Columns="2">
                        <TextBlock Foreground="#FF61758A" Text="类型" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedAddress.Type}" />
                    </UniformGrid>
                    <UniformGrid Grid.Row="5" Margin="0,10,0,0" Columns="2">
                        <TextBlock Foreground="#FF61758A" Text="当前值" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedAddress.MonitorValue}" />
                    </UniformGrid>
                    <UniformGrid Grid.Row="6" Margin="0,10,0,0" Columns="2">
                        <TextBlock Foreground="#FF61758A" Text="单位" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedAddress.Unit}" />
                    </UniformGrid>
                    <UniformGrid Grid.Row="7" Margin="0,10,0,16" Columns="2">
                        <TextBlock Foreground="#FF61758A" Text="备注" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedAddress.Remark}" TextWrapping="Wrap" />
                    </UniformGrid>
                    <Border
                        Grid.Row="8"
                        Padding="12"
                        Background="#FFF8FAFD"
                        BorderBrush="#FFE4EAF1"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#FF1B2A41"
                                Text="写入控制" />
                            <TextBlock
                                Margin="0,10,0,4"
                                Foreground="#FF61758A"
                                Text="输入要写入的值" />
                            <TextBox
                                Padding="8"
                                Text="{Binding PendingWriteValue, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,12,0,0"
                                Foreground="#FF61758A"
                                Text="可先选择一条地址，再点“写入输入值”或“写入测试值”。" />
                        </StackPanel>
                    </Border>

                   
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="12"
                Background="White"
                BorderBrush="#FFE1E7EF"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#FF1B2A41"
                        Text="AI Markdown 演示区" />

                    <StackPanel Grid.Row="1" Margin="0,10,0,12" Orientation="Horizontal">
                        <CheckBox
                            x:Name="ShowThinkingCheckBox"
                            Margin="0,0,16,0"
                            Content="显示深度思考"
                            IsChecked="True" />
                        <TextBlock VerticalAlignment="Center" Text="流速度" />
                        <Slider
                            x:Name="SpeedSlider"
                            Width="120"
                            Margin="8,0,0,0"
                            IsSnapToTickEnabled="True"
                            Maximum="100"
                            Minimum="10"
                            TickFrequency="10"
                            Value="30" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding ElementName=SpeedSlider, Path=Value, StringFormat='{}{0:0} ms'}" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <cc:AiMarkdownViewer
                            x:Name="MarkdownViewer"
                            IsStreaming="{Binding IsStreaming}"
                            MarkdownText="{Binding MarkdownContent}"
                            ShowThinking="{Binding ElementName=ShowThinkingCheckBox, Path=IsChecked}"
                            StreamingSpeed="{Binding ElementName=SpeedSlider, Path=Value}"
                            ThinkingContent="{Binding ThinkingContent}" />

                        <Border
                            Margin="16"
                            Padding="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#FFFFF3E0"
                            BorderBrush="#FFFFCC80"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#FFF57C00"
                                Text="状态：正在输出" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
