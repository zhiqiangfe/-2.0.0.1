<Page
    x:Class="SUNWODA_SEVB.Views.Pages.Demo.AIMarkdownViewerTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:SUNWODA_SEVB.Component.CustomControls;assembly=SUNWODA_SEVB.Component"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AIMarkdownViewerTestPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  控制面板  -->
        <Border
            Grid.Column="0"
            Background="#FFF5F5F5"
            BorderBrush="#FFE0E0E0"
            BorderThickness="0,0,1,0">
            <StackPanel Margin="15">
                <TextBlock
                    Margin="0,0,0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="控制面板" />

                <!--  操作按钮  -->
                <Button
                    Width="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=ActualWidth}"
                    Height="40"
                    Margin="0,5"
                    Padding="10,8"
                    Background="#FF2196F3"
                    BorderThickness="0"
                    Command="{Binding SimulateAiResponseCommand}"
                    Content="模拟AI响应测试"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1976D2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    Width="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=ActualWidth}"
                    Height="40"
                    Margin="0,5"
                    Padding="10,8"
                    Background="#FF4CAF50"
                    BorderThickness="0"
                    Command="{Binding SimulateThinkingCommand}"
                    Content="模拟深度思考测试"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF388E3C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    Width="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=ActualWidth}"
                    Height="40"
                    Margin="0,5"
                    Padding="10,8"
                    Background="#FFFF9800"
                    BorderThickness="0"
                    Command="{Binding TestMarkdownCommand}"
                    Content="测试Markdown部分文本功能"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF57C00" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    Width="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}, Path=ActualWidth}"
                    Height="40"
                    Margin="0,5"
                    Padding="10,8"
                    Background="#59949A"
                    BorderThickness="0"
                    Command="{Binding ClearAllCommand}"
                    Content="清空"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0E8490" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Separator Margin="0,15" />

                <!--  设置选项  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontWeight="SemiBold"
                    Text="设置选项" />

                <CheckBox
                    x:Name="ShowThinkingCheckBox"
                    Margin="0,5"
                    Content="显示深度思考"
                    IsChecked="True" />

                <StackPanel Margin="0,10,0,5" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="流速度: " />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Text="{Binding ElementName=SpeedSlider, Path=Value, StringFormat='{}{0:0} ms'}" />
                </StackPanel>
                <Slider
                    x:Name="SpeedSlider"
                    Margin="-8,0"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="10"
                    TickFrequency="10"
                    Value="30" />

                <!--  状态指示  -->
                <Border
                    Margin="0,20,0,0"
                    Padding="10"
                    Background="#FFFFF3E0"
                    BorderBrush="#FFFFCC80"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#FFF57C00"
                            Text="状态：正在输出" />
                        <!--<ProgressBar
                            Height="3"
                            Margin="0,5,0,0"
                            IsIndeterminate="True" />-->
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!--  Markdown渲染区域  -->
        <Grid Grid.Column="1">
            <cc:AiMarkdownViewer
                x:Name="MarkdownViewer"
                Margin="10"
                IsStreaming="{Binding IsStreaming}"
                MarkdownText="{Binding MarkdownContent}"
                ShowThinking="{Binding ElementName=ShowThinkingCheckBox, Path=IsChecked}"
                StreamingSpeed="{Binding ElementName=SpeedSlider, Path=Value}"
                ThinkingContent="{Binding ThinkingContent}" />
        </Grid>
    </Grid>
</Page>
