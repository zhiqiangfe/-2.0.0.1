<Page
    x:Class="SUNWODA_SEVB.Views.Pages.SmartManagement.DeviceOeeAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SUNWODA_SEVB.ViewModels.Pages.SmartManagement"
    d:DataContext="{d:DesignInstance Type=vm:VM_DeviceOeeAnalysisPage}"
    d:DesignHeight="900"
    d:DesignWidth="1600"
    Background="#F4F7FB"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7E1EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6B7A" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Background" Value="#EEF3FA" />
            <Setter Property="BorderBrush" Value="#CCD6E3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,22,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="86" />
                <RowDefinition Height="124" />
                <RowDefinition Height="282" />
                <RowDefinition Height="122" />
                <RowDefinition Height="320" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="30" FontWeight="Bold" Foreground="#1F2937" Text="设备 OEE 分析" />
                <TextBlock Margin="0,8,0,0" FontSize="16" Foreground="#526174" Text="从指标、趋势、状态时间轴和停机明细定位 OEE 损失原因" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,18,0,0" Padding="18,10" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width=".85*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width=".8*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource MutedText}" Text="产线" />
                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource MutedText}" Text="设备" />
                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource MutedText}" Text="班次" />
                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource MutedText}" Text="时间范围" />
                        <TextBox Height="34" Margin="0,4,0,0" Padding="10,0" Background="#EEF3FA" BorderBrush="#CCD6E3" Foreground="#1F2937" IsReadOnly="True" Text="{Binding TimeRange, Mode=OneWay}" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource MutedText}" Text="粒度" />
                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Granularities}" SelectedItem="{Binding SelectedGranularity}" />
                    </StackPanel>
                    <Button Grid.Column="5" Margin="0,17,16,0" Background="#2F66F6" BorderBrush="#2F66F6" Command="{Binding RefreshCommand}" Content="查询" Foreground="White" />
                    <Button Grid.Column="6" Margin="0,17,0,0" Background="#EEF3FA" BorderBrush="#D7E1EF" Command="{Binding ExportCommand}" Content="导出" Foreground="#46566A" />
                </Grid>
            </Border>

            <ItemsControl Grid.Row="2" Margin="0,18,0,0" ItemsSource="{Binding MetricCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,16,0" Padding="18,15" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Title}" />
                                <TextBlock Margin="0,6,0,0" FontSize="36" FontWeight="Bold" Foreground="#111827" Text="{Binding Value}" />
                                <TextBlock Margin="0,4,0,0" Foreground="{Binding AccentBrush}" Text="{Binding Description}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Padding="24,16" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="OEE 趋势" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" Text="OEE / 稼动率 / 目标线，点击时间点联动下方明细" />
                        </StackPanel>
                        <Canvas Grid.Row="1" Margin="26,22,26,12">
                            <Line X1="0" X2="760" Y1="172" Y2="172" Stroke="#B8C3D4" />
                            <Line X1="0" X2="0" Y1="24" Y2="172" Stroke="#B8C3D4" />
                            <Line X1="0" X2="760" Y1="58" Y2="58" Stroke="#FF4D4F" StrokeDashArray="8 8" StrokeThickness="2" />
                            <Polyline Points="{Binding AvailabilityTrendPoints}" Stroke="#27AE60" StrokeThickness="3" />
                            <Polyline Points="{Binding OeeTrendPoints}" Stroke="#2F66F6" StrokeThickness="4" />
                        </Canvas>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="24,16" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="OEE 构成与自动总结" />
                        <TextBlock Margin="0,6,0,16" Style="{StaticResource MutedText}" Text="OEE = 稼动率 × 性能效率 × 良率" />
                        <ItemsControl ItemsSource="{Binding OeeComponents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="15" Foreground="#344054" Text="{Binding Name}" />
                                        <Border Grid.Column="1" Height="24" Background="#EAF0F8" CornerRadius="3">
                                            <Border Width="{Binding Width}" HorizontalAlignment="Left" Background="{Binding FillBrush}" CornerRadius="3" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#526174" Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,18,0,0" Padding="16,12" Background="#ECF3FC" BorderBrush="#CCDAEE" BorderThickness="1" CornerRadius="4">
                            <TextBlock Foreground="#46566A" LineHeight="24" Text="{Binding Summary}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Margin="0,18,0,0" Padding="24,14" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="设备状态时间轴" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" Text="点击红色故障段，下方表格定位到对应停机和报警" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="220,10,46,0" VerticalAlignment="Top">
                        <ItemsControl ItemsSource="{Binding StatusSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Height="28" Margin="2,0" Background="{Binding FillBrush}" CornerRadius="3" ToolTip="{Binding Tooltip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,34,0,0" HorizontalAlignment="Left" Foreground="#617083" Text="08:00" />
                        <TextBlock Margin="0,34,0,0" HorizontalAlignment="Center" Foreground="#617083" Text="12:00" />
                        <TextBlock Margin="0,34,0,0" HorizontalAlignment="Right" Foreground="#617083" Text="20:00" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="5" Margin="0,18,0,0" Padding="24,14" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="停机 / 报警明细" />
                    <DataGrid
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        AutoGenerateColumns="False"
                        Background="White"
                        BorderBrush="#D7E1EF"
                        BorderThickness="1"
                        CanUserAddRows="False"
                        ColumnHeaderHeight="36"
                        Foreground="#243044"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="#E5EAF2"
                        IsReadOnly="True"
                        ItemsSource="{Binding DowntimeDetails}"
                        RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="120" Binding="{Binding StartTime}" Header="开始时间" />
                            <DataGridTextColumn Width="120" Binding="{Binding EndTime}" Header="结束时间" />
                            <DataGridTextColumn Width="100" Binding="{Binding Status}" Header="状态" />
                            <DataGridTextColumn Width="130" Binding="{Binding Duration}" Header="持续时间" />
                            <DataGridTextColumn Width="160" Binding="{Binding Station}" Header="工位" />
                            <DataGridTextColumn Width="*" MinWidth="220" Binding="{Binding AlarmName}" Header="报警名称" />
                            <DataGridTextColumn Width="130" Binding="{Binding Impact}" Header="影响产量" />
                            <DataGridTextColumn Width="130" Binding="{Binding ProcessState}" Header="处理状态" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
