<Page
    x:Class="SUNWODA_SEVB.Views.Pages.Common.UserCenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="UserCenter"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Page.Resources>

        <!--  定义样式资源  -->

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>


        <!--  权限等级颜色  -->

        <SolidColorBrush x:Key="SuperAdminBrush" Color="#E91E63" />
        <SolidColorBrush x:Key="AdminBrush" Color="#2196F3" />
        <SolidColorBrush x:Key="EngineerBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="GuestBrush" Color="#9E9E9E" />


        <!--  数据转换器  -->

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converter:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Page.Resources>

    <Grid>
        <!--  主容器  -->
        <Border Background="White" Effect="{DynamicResource EffectShadow2}">
            <Grid>
                <!--  登录界面  -->
                <Grid x:Name="LoginPanel" Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题区域  -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,20"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeaderTextStyle}"
                            Text="用户登录" />
                        <hc:Divider Margin="50,0" LineStrokeThickness="1" />
                    </StackPanel>

                    <!--  登录表单  -->
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="LoginForm"
                            Width="500"
                            HorizontalAlignment="Center">

                            <!--  Logo或图标  -->
                            <iconPacks:PackIconIonicons
                                Width="80"
                                Height="80"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Kind="ContactMD" />

                            <!--  用户账号输入  -->
                            <hc:TextBox
                                x:Name="UserAccountTextBox"
                                Margin="0,10"
                                hc:InfoElement.Placeholder="请输入用户账号"
                                hc:InfoElement.ShowClearButton="True"
                                Text="{Binding UserAccount, UpdateSourceTrigger=PropertyChanged}">
                                <hc:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                                </hc:TextBox.InputBindings>
                            </hc:TextBox>

                            <!--  密码输入  -->
                            <uc:PasswordInputBox
                                x:Name="PasswordBox"
                                Margin="0,10"
                                Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ShowPassword="{Binding ShowPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                WaterMark="请输入密码">
                                <uc:PasswordInputBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                                </uc:PasswordInputBox.InputBindings>
                            </uc:PasswordInputBox>

                            <!--  记住密码  -->
                            <!--<CheckBox
                                Margin="0,15,0,0"
                                Content="记住密码"
                                IsChecked="{Binding RememberPassword}" />-->

                            <!--  登录按钮  -->
                            <Button
                                Width="200"
                                Margin="0,10"
                                Command="{Binding LoginCommand}"
                                Content="登录"
                                Style="{StaticResource ButtonPrimary}" />

                            <!--  访客模式  -->
                            <TextBlock Margin="0,10" HorizontalAlignment="Center">
                                <Run Text="或者" />
                                <Hyperlink Command="{Binding GuestModeCommand}">
                                    <Run Foreground="{DynamicResource PrimaryBrush}" Text="以访客身份继续" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  底部信息  -->
                    <StackPanel Grid.Row="2">
                        <hc:Divider Margin="50,0" LineStrokeThickness="1" />
                        <TextBlock
                            Margin="0,10"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource GuestBrush}"
                            Text="当前状态：未登录 (访客权限)" />
                    </StackPanel>
                </Grid>

                <!--  用户中心界面（登录后显示）  -->
                <Grid
                    x:Name="UserCenterPanel"
                    d:Visibility="Collapsed"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  顶部用户信息栏  -->
                    <Border
                        Grid.Row="0"
                        Background="{DynamicResource RegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid Margin="20,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  用户头像  -->
                            <Border
                                Grid.Column="0"
                                Width="50"
                                Height="50"
                                Margin="0,0,15,0"
                                d:Background="#2196F3"
                                Background="{Binding RoleBrush}"
                                CornerRadius="25">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    d:Text="管"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding UserLogoText}" />
                            </Border>

                            <!--  用户信息  -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="18" FontWeight="SemiBold">
                                    <Run Text="欢迎，" />
                                    <Run d:Text="Admin" Text="{Binding UserName}" />
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0">
                                    <Run Foreground="Gray" Text="权限等级：" />
                                    <Run
                                        d:Text="管理员"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding RoleBrush}"
                                        Text="{Binding RoleDisplay}" />
                                </TextBlock>
                            </StackPanel>

                            <!--  操作按钮  -->
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Margin="0,0,10,0"
                                    Command="{Binding ChangePasswordCommand}"
                                    Content="修改密码"
                                    Style="{StaticResource ButtonInfo}" />
                                <Button
                                    Command="{Binding LogoutCommand}"
                                    Content="退出登录"
                                    Style="{StaticResource ButtonDanger}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  主内容区域  -->
                    <TabControl
                        Grid.Row="1"
                        FontSize="15"
                        Style="{StaticResource TabControlInLine}">
                        <!--  个人信息标签  -->
                        <TabItem Header="个人信息" IsSelected="{Binding SelectInfoTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <hc:Card Margin="0,0,0,15">
                                        <Grid Margin="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="35" />
                                                <RowDefinition Height="35" />
                                                <RowDefinition Height="35" />
                                                <RowDefinition Height="35" />
                                                <RowDefinition Height="35" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="用户ID：" />
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{Binding UserAccount}" />

                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="用户名：" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{Binding UserName}" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="权限角色：" />
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                Background="{Binding RoleBrush}"
                                                CornerRadius="3">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding RoleDisplay}" />
                                            </Border>

                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="创建时间：" />
                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{Binding CreatedTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />

                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Text="最后登录：" />
                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{Binding LastLoginTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                        </Grid>
                                    </hc:Card>

                                    <!--  权限说明  -->
                                    <hc:Card>
                                        <StackPanel Margin="20">
                                            <TextBlock
                                                Margin="0,0,0,15"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="当前权限说明" />
                                            <ItemsControl ItemsSource="{Binding CurrentPermissions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <iconPacks:PackIconModern
                                                                Grid.Column="0"
                                                                Foreground="#4CAF50"
                                                                Kind="Check" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Margin="5,0,0,0"
                                                                Text="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </hc:Card>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!--  用户管理标签（仅管理员可见）  -->
                        <TabItem Header="用户管理" Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  工具栏  -->
                                <hc:ButtonGroup Grid.Row="0">
                                    <Button Command="{Binding AddUserCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="AccountPlus" />
                                            <TextBlock Margin="10,0" Text="新增用户" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding RefreshUsersCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconRemixIcon Kind="RefreshLine" />
                                            <TextBlock Margin="10,0" Text="刷新" />
                                        </StackPanel>
                                    </Button>
                                </hc:ButtonGroup>


                                <!--  用户列表  -->
                                <DataGrid
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    AutoGenerateColumns="False"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CanUserAddRows="False"
                                    HeadersVisibility="All"
                                    ItemsSource="{Binding UserList}"
                                    SelectedItem="{Binding SelectedUser}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="120"
                                            Binding="{Binding Account}"
                                            Header="账号" />
                                        <DataGridTextColumn
                                            Width="120"
                                            Binding="{Binding Name}"
                                            Header="用户名" />

                                        <DataGridTemplateColumn Width="100" Header="权限角色">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Margin="2"
                                                        Padding="6,2"
                                                        Background="{Binding RoleColorBrush}"
                                                        CornerRadius="3">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Text="{Binding Role}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn
                                            Width="200"
                                            Binding="{Binding CreatedDateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Header="创建时间" />
                                        <DataGridTextColumn
                                            Width="200"
                                            Binding="{Binding LastLoginDateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Header="最后登录" />

                                        <DataGridTemplateColumn Width="300" Header="操作">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button
                                                            Margin="2"
                                                            Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ButtonInfo.Small}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Kind="AccountEdit" />
                                                                <TextBlock Margin="5,0" Text="编辑" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            Margin="2"
                                                            Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            Style="{StaticResource ButtonWarning.Small}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Kind="LockReset" />
                                                                <TextBlock Margin="5,0" Text="重置密码" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            Margin="2"
                                                            Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            Style="{StaticResource ButtonDanger.Small}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <iconPacks:PackIconMaterial Kind="AccountRemove" />
                                                                <TextBlock Margin="5,0" Text="删除" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!--  权限设置标签（仅超级管理员可见）  -->
                        <TabItem Header="权限设置" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <!--  权限等级说明  -->
                                    <hc:Card Margin="0,0,0,20">
                                        <StackPanel Margin="20">
                                            <TextBlock
                                                Margin="0,0,0,15"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Text="系统权限等级" />

                                            <!--  超级管理员  -->
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="15"
                                                Background="#FFF3E0"
                                                CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Border
                                                            Padding="8,3"
                                                            Background="{StaticResource SuperAdminBrush}"
                                                            CornerRadius="3">
                                                            <TextBlock
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="超级管理员" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="Wrap">
                                                        拥有系统所有权限，可管理所有用户和设置
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!--  管理员  -->
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="15"
                                                Background="#E3F2FD"
                                                CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Border
                                                            Padding="8,3"
                                                            Background="{StaticResource AdminBrush}"
                                                            CornerRadius="3">
                                                            <TextBlock
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="管理员" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="Wrap">
                                                        可管理普通用户，修改系统配置，查看所有数据
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!--  工程师  -->
                                            <Border
                                                Margin="0,0,0,10"
                                                Padding="15"
                                                Background="#E8F5E9"
                                                CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Border
                                                            Padding="8,3"
                                                            Background="{StaticResource EngineerBrush}"
                                                            CornerRadius="3">
                                                            <TextBlock
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="工程师" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="Wrap">
                                                        可执行技术操作，修改部分配置，查看相关数据
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!--  访客  -->
                                            <Border
                                                Padding="15"
                                                Background="#F5F5F5"
                                                CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Border
                                                            Padding="8,3"
                                                            Background="{StaticResource GuestBrush}"
                                                            CornerRadius="3">
                                                            <TextBlock
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="访客" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="Wrap">
                                                        仅可查看公开数据，无修改权限
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </hc:Card>

                                    <!--  权限矩阵  -->
                                    <hc:Card>
                                        <StackPanel Margin="20">
                                            <TextBlock
                                                Margin="0,0,0,15"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Text="功能权限矩阵" />
                                            <DataGrid
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="False"
                                                HeadersVisibility="All"
                                                ItemsSource="{Binding PermissionMatrix}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn
                                                        Width="150"
                                                        Binding="{Binding FunctionName}"
                                                        Header="功能名称" />
                                                    <DataGridCheckBoxColumn
                                                        Width="80"
                                                        Binding="{Binding Admin}"
                                                        Header="管理员" />
                                                    <DataGridCheckBoxColumn
                                                        Width="80"
                                                        Binding="{Binding Engineer}"
                                                        Header="工程师" />
                                                    <DataGridCheckBoxColumn
                                                        Width="80"
                                                        Binding="{Binding Guest}"
                                                        Header="访客" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </hc:Card>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!--  操作日志标签  -->
                        <!--<TabItem Header="操作日志" Visibility="{Binding CanViewLogs, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>-->

                        <!--  筛选条件  -->
                        <!--<hc:Card Grid.Row="0" Margin="0,0,0,10">
                                    <Grid Margin="15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Text="开始日期：" />
                                        <DatePicker Grid.Column="1" SelectedDate="{Binding LogStartDate}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="20,0,10,0"
                                            VerticalAlignment="Center"
                                            Text="结束日期：" />
                                        <DatePicker Grid.Column="3" SelectedDate="{Binding LogEndDate}" />

                                        <Button
                                            Grid.Column="5"
                                            Command="{Binding SearchLogsCommand}"
                                            Content="查询"
                                            Style="{StaticResource ButtonPrimary}" />
                                    </Grid>
                                </hc:Card>-->

                        <!--  日志列表  -->
                        <!--<DataGrid
                                    Grid.Row="1"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    ItemsSource="{Binding OperationLogs}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="150"
                                            Binding="{Binding DateTime}"
                                            Header="时间" />
                                        <DataGridTextColumn
                                            Width="100"
                                            Binding="{Binding Username}"
                                            Header="用户" />
                                        <DataGridTextColumn
                                            Width="100"
                                            Binding="{Binding Action}"
                                            Header="操作类型" />
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding Description}"
                                            Header="详细描述" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>-->
                    </TabControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
