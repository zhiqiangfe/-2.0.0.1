<Window
    x:Class="SUNWODA_SEVB.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SUNWODA_SEVB.Tool.Converter;assembly=SUNWODA_SEVB.Tool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="MainWindow"
    Width="1200"
    Height="800"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  转换器声明  -->
        <converters:LogLevelConverter x:Key="LogLevelConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!--  样式定义  -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="MinWidth" Value="100" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="5" />
        </Style>

        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部工具栏  -->
        <ToolBar Grid.Row="0" Height="40">
            <Button Command="{Binding CheckMesStatusCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,5,0" Text="🔍" />
                    <TextBlock Text="检查状态" />
                </StackPanel>
            </Button>

            <Button Command="{Binding ReloadMesConfigCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,5,0" Text="🔄" />
                    <TextBlock Text="重载配置" />
                </StackPanel>
            </Button>

            <Separator />

            <Button Command="{Binding ClearLogsCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,5,0" Text="🗑️" />
                    <TextBlock Text="清空日志" />
                </StackPanel>
            </Button>
        </ToolBar>

        <!--  主内容区域  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧控制面板  -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!--  MES配置信息  -->
                    <GroupBox Header="MES配置信息">
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{Binding MesConfigInfo}"
                            TextWrapping="Wrap" />
                    </GroupBox>

                    <!--  测试参数  -->
                    <GroupBox Header="测试参数">
                        <StackPanel>
                            <Label Content="产品序列号:" />
                            <TextBox Margin="5,0,5,5" Text="{Binding ProductSn}" />

                            <Label Content="测试结果:" />
                            <ComboBox Margin="5,0,5,5" Text="{Binding TestResult}">
                                <ComboBoxItem>PASS</ComboBoxItem>
                                <ComboBoxItem>FAIL</ComboBoxItem>
                            </ComboBox>

                            <Button
                                Margin="5"
                                Command="{Binding GenerateTestDataCommand}"
                                Content="生成测试数据" />
                        </StackPanel>
                    </GroupBox>

                    <!--  MES测试功能  -->
                    <GroupBox Header="MES测试功能">
                        <StackPanel>
                            <Button Command="{Binding TestOfflineUploadCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="离线数据上传" />
                                    <TextBlock
                                        FontSize="10"
                                        Opacity="0.7"
                                        Text="测试离线测试数据上传" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding TestMarkingUploadCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="Marking上传" />
                                    <TextBlock
                                        FontSize="10"
                                        Opacity="0.7"
                                        Text="测试Marking数据上传" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding BatchTestCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="批量测试" />
                                    <TextBlock
                                        FontSize="10"
                                        Opacity="0.7"
                                        Text="批量上传多个产品数据" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </GroupBox>

                    <!--  原有日志测试功能  -->
                    <GroupBox Header="日志测试">
                        <StackPanel>
                            <Button Command="{Binding TestLogCommand}" Content="测试日志" />
                            <Button Command="{Binding ShowInfoCommand}" Content="信息日志" />
                            <Button Command="{Binding ShowWarningCommand}" Content="警告日志" />
                            <Button Command="{Binding ShowErrorCommand}" Content="错误日志" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!--  右侧日志显示区  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="测试日志输出">
                    <Grid>
                        <ListBox
                            FontFamily="Consolas"
                            FontSize="12"
                            ItemsSource="{Binding TestDataLog}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=., Converter={StaticResource LogLevelConverter}, ConverterParameter=ERROR}" Value="True">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=., Converter={StaticResource LogLevelConverter}, ConverterParameter=WARN}" Value="True">
                                                        <Setter Property="Foreground" Value="Orange" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=., Converter={StaticResource LogLevelConverter}, ConverterParameter=SUCCESS}" Value="True">
                                                        <Setter Property="Foreground" Value="Green" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  进度指示器  -->
                        <Border
                            Background="White"
                            Opacity="0.8"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar
                                    Width="200"
                                    Height="20"
                                    IsIndeterminate="True" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Text="处理中，请稍候..." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!--  底部状态栏  -->
        <StatusBar Grid.Row="2" Height="30">
            <StatusBarItem>
                <TextBlock FontWeight="Bold" Text="状态: " />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="最后日志: " />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock
                    MaxWidth="500"
                    Text="{Binding LogMessage}"
                    TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
