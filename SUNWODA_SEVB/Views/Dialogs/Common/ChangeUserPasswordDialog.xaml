<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.Common.ChangeUserPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Dialogs.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Width="300"
    Background="White"
    CornerRadius="10"
    mc:Ignorable="d">

    <Border.Resources>
        <converter:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Border.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button
            Margin="0,0,0,10"
            HorizontalAlignment="Right"
            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
            BorderThickness="0"
            Command="{Binding CloseCommand}">
            <Button.Style>
                <Style BasedOn="{StaticResource ButtonIconCircular}" TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#ff5858" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter Property="Background" Value="#e1e1e1" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <StackPanel Grid.Row="1">

            <StackPanel>
                <uc:PasswordInputBox
                    BorderBrush="{Binding ReconfirmOldPasswordBrush}"
                    Password="{Binding ReconfirmOldPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    WaterMark="请输入原密码" />
                <Grid>
                    <Border Margin="0,5,0,10" />
                    <TextBlock
                        d:Visibility="Collapsed"
                        Foreground="{Binding ReconfirmOldPasswordBrush}"
                        Text="{Binding ReconfirmOldPasswordErrorMessage}"
                        Visibility="{Binding IsReconfirmOldPassword, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,15">
                <uc:PasswordInputBox
                    BorderBrush="{Binding AgainReconfirmNewPasswordBrush}"
                    Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    WaterMark="请输入新密码" />
            </StackPanel>

            <StackPanel>
                <uc:PasswordInputBox
                    BorderBrush="{Binding AgainReconfirmNewPasswordBrush}"
                    Password="{Binding AgainReconfirmNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    WaterMark="再次确认新密码" />
                <Grid>
                    <Border Margin="0,5,0,10" />
                    <TextBlock
                        d:Visibility="Collapsed"
                        Foreground="{Binding AgainReconfirmNewPasswordBrush}"
                        Text="{Binding AgainReconfirmNewPasswordErrorMessage}"
                        Visibility="{Binding IsAgainReconfirmNewPassword, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>

            </StackPanel>

            <Button
                Command="{Binding ReconfirmCommand}"
                Content="修改"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</Border>
