<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.Common.EditUserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Dialogs.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="300"
    Background="White"
    CornerRadius="10"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button
            Margin="0,0,0,10"
            HorizontalAlignment="Right"
            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
            BorderThickness="0"
            Command="{Binding CloseCommand}">
            <Button.Style>
                <Style BasedOn="{StaticResource ButtonIconCircular}" TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#ff5858" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter Property="Background" Value="#e1e1e1" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <StackPanel Grid.Row="1">
            <TextBox
                Margin="0,0,0,10"
                hc:InfoElement.Title="账号"
                hc:InfoElement.TitlePlacement="Left"
                hc:InfoElement.TitleWidth="60"
                IsEnabled="False"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding Result.Account}" />
            <TextBox
                Margin="0,0,0,10"
                hc:InfoElement.Placeholder="请输入修改的用户名"
                hc:InfoElement.Title="用户名"
                hc:InfoElement.TitlePlacement="Left"
                hc:InfoElement.TitleWidth="60"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding Result.Name}" />
            <ComboBox
                Margin="0,0,0,10"
                hc:InfoElement.Title="用户等级"
                hc:InfoElement.TitlePlacement="Left"
                hc:InfoElement.TitleWidth="60"
                ItemsSource="{Binding CanEditUserRoleList}"
                SelectedItem="{Binding Result.Role}"
                Style="{StaticResource ComboBoxExtend}" />
            <Button
                Command="{Binding EditUserCommand}"
                Content="修改"
                Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </Grid>
</Border>
